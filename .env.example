# Start with: node --env-file=.env server.mjs
PORT=8080
# Production: set to the public HTTPS origin, no trailing slash.
PUBLIC_ORIGIN=
# Mount a Railway volume at /data and set REQUEST_DATA_DIR=/data.
# Requests remain disabled in production without durable storage + admin access.
REQUEST_DATA_DIR=
# Generate a long random token and store in Railway Variables, never Git.
ADMIN_TOKEN=
